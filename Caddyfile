{
    # 内网使用，无需 email
}

# Caddy listening on port 8000 (HTTPS)
:8000 {
    # Use local certificates
    tls .ssl/cert.pem .ssl/key.pem
    # 後端 API 反向代理 (Port 6543)
    handle /health {
        reverse_proxy localhost:6543
    }
    
    handle /api/* {
        reverse_proxy localhost:6543
    }

    handle /ws/* {
        reverse_proxy localhost:6543
    }

    handle /docs {
        reverse_proxy localhost:6543
    }
    
    handle /openapi.json {
        reverse_proxy localhost:6543
    }

    # 前端静态文件服务 (React build)
    handle /* {
        root * /Users/john/wkgit/meeting/frontend/dist
        try_files {path} /index.html
        file_server
    }
    
    # 启用 gzip 压缩
    encode gzip
}
